<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MediQueue System Administration Portal</title>
  <link rel="icon" type="image/svg+xml" href="favicon1.svg">
  <link rel="stylesheet" href="admin-portal.css">

</head>
<body>

<!-- LOGIN SCREEN -->
<div class="login-wrapper" id="login-screen">
  <!-- LEFT PANEL ONLY WITH AMBIENT FLOATING ICONS -->
  <div class="login-left-panel">
    <div class="bg-floating-icons">
      <!-- Hospital Cross / Medical -->
      <svg class="floating-icon icon-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M2 12h20"/></svg>
      <!-- Heartbeat Wave / EKG -->
      <svg class="floating-icon icon-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      <!-- Capsule Pill -->
      <svg class="floating-icon icon-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10.5 20.4l-7.5-7.5a5 5 0 0 1 7.07-7.07l7.5 7.5a5 5 0 0 1-7.07 7.07z"/><line x1="8.5" y1="8.5" x2="15.5" y2="15.5"/></svg>
      <!-- Shield / Security -->
      <svg class="floating-icon icon-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <!-- Clock / Queue Time -->
      <svg class="floating-icon icon-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <!-- Stethoscope -->
      <svg class="floating-icon icon-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4.8 2.3A.3.3 0 0 0 5 2.5h2a.3.3 0 0 0 .2-.2V1a1 1 0 0 0-2 0v1.3zm14.4 0a.3.3 0 0 0 .2.2h2a.3.3 0 0 0 .2-.2V1a1 1 0 0 0-2 0v1.3zM6 3v6a6 6 0 0 0 12 0V3M12 15v3a4 4 0 0 0 8 0v-1"/></svg>
    </div>

    <div class="panel-header-logo">
      <div class="logo-box">
        <!-- USER-ROUND SVG LOGO (WHITE) -->
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="5"/>
          <path d="M20 21a8 8 0 0 0-16 0"/>
        </svg>
      </div>
      <span class="logo-title">MediQueue Admin</span>
    </div>

    <div class="panel-hero-content">
      <h1 class="hero-title">Clinic Control Center</h1>
      <p class="hero-desc">Manage doctors, staff, queue settings, and view audit logs from a single secure dashboard.</p>
    </div>

    <div class="panel-bottom-stats">
    </div>
  </div>

  <!-- RIGHT PANEL WITH SIGN IN FORM -->
  <div class="login-right-panel">
    <div class="login-form-box">
      <h2>Administrator Sign In</h2>
      <p class="subtext">Restricted access. Authorized personnel only.</p>

      <form onsubmit="handleLogin(event)">
        <div class="form-group">
          <label for="admin-email">Email Address</label>
          <input type="email" id="admin-email" value="admin@mediq.ph" required>
        </div>
        <div class="form-group">
          <label for="admin-password">Password</label>
          <input type="password" id="admin-password" value="••••••••" required>
        </div>
        <button type="submit" class="btn-login-submit">Sign In Securely</button>
      </form>
    </div>
  </div>
</div>

<!-- MAIN ADMIN APP -->
<div class="admin-app hidden" id="admin-portal-app">
  
  <!-- SPOTIFY-STYLE UNIFIED FLOATING SIDEBAR -->
  <aside class="sidebar" id="admin-sidebar">
    <!-- Clickable Brand Logo Header -->
    <div class="nav-block brand-block">
      <div class="brand" onclick="toggleAdminSidebar()" title="Click to Toggle Navigation Clean Mode">
        <div class="icon-slot">
          <!-- USER-ROUND SVG LOGO (WHITE) -->
          <svg viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="5"/>
            <path d="M20 21a8 8 0 0 0-16 0"/>
          </svg>
        </div>
        <span class="brand-text">MediQueue Admin</span>
      </div>
      <button class="collapse-btn" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation">‹</button>
    </div>

    <nav class="nav-block menu-block">
      <button class="nav-btn active" data-tab="dashboard" onclick="switchAdminTab('dashboard')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
        </div>
        <span class="nav-label">Dashboard</span>
      </button>

      <button class="nav-btn" data-tab="analytics" onclick="switchAdminTab('analytics')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
        </div>
        <span class="nav-label">Analytics & Reports</span>
      </button>

      <button class="nav-btn" data-tab="doctors" onclick="switchAdminTab('doctors')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        </div>
        <span class="nav-label">Doctor Management</span>
      </button>

      <button class="nav-btn" data-tab="staff" onclick="switchAdminTab('staff')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <span class="nav-label">Staff Management</span>
      </button>

      <button class="nav-btn" data-tab="audit" onclick="switchAdminTab('audit')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <span class="nav-label">Audit Logs</span>
      </button>

      <button class="nav-btn" data-tab="config" onclick="switchAdminTab('config')">
        <div class="icon-slot">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <span class="nav-label">Configuration</span>
      </button>

      <!-- Clickable Profile Trigger -->
      <div class="admin-profile" onclick="openAdminProfileDrawer()" title="Open Admin Profile">
        <div class="avatar">A</div>
        <div class="profile-info">
          <div class="name">Administrator</div>
          <div class="role">System Superuser</div>
        </div>
      </div>
    </nav>
  </aside>

  <!-- MAIN CONTAINER -->
  <div class="main-container">
    <header class="admin-header">
      <div class="search-bar">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="global-search-input" placeholder="Search doctors, staff, logs..." oninput="handleGlobalSearch(this.value)">
      </div>

      <div class="header-actions">
        <div class="live-status-indicator">
          <div class="live-pulse-dot"></div>
          <span>Database & Displays Synced</span>
        </div>
        <button class="btn-secondary btn-sm">Last 7 Days</button>
      </div>
    </header>

    <main class="portal-content">
      <!-- DASHBOARD -->
      <section class="tab-content active" id="tab-admin-dashboard">
        <div class="page-header">
          <h1>Executive Dashboard</h1>
          <p>Clinic-wide operational overview.</p>
        </div>

        <div class="metrics-grid">
          <div class="metric-card tint-blue">
            <div class="value">87</div>
            <div class="title">Total Patients Today</div>
          </div>
          <div class="metric-card tint-green">
            <div class="value text-green">9 min</div>
            <div class="title">Avg Wait Time</div>
          </div>
          <div class="metric-card tint-purple">
            <div class="value text-purple">14 min</div>
            <div class="title">Avg Consult Time</div>
          </div>
          <div class="metric-card tint-orange">
            <div class="value text-orange">3 / 4</div>
            <div class="title">Active Counters</div>
          </div>
        </div>

        <div class="dashboard-split mt-20">
          <div class="panel-card chart-card">
            <h3>24-Hour Patient Volume</h3>
            <div class="svg-chart-container mt-12">
              <svg viewBox="0 0 500 180" class="line-chart">
                <defs>
                  <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#2563EB" stop-opacity="0.25"/>
                    <stop offset="100%" stop-color="#2563EB" stop-opacity="0.0"/>
                  </linearGradient>
                </defs>
                <path d="M 10 160 Q 80 150 120 130 T 200 40 T 280 90 T 360 50 T 440 130 T 490 160 L 490 170 L 10 170 Z" fill="url(#chartGradient)"/>
                <path d="M 10 160 Q 80 150 120 130 T 200 40 T 280 90 T 360 50 T 440 130 T 490 160" fill="none" stroke="#2563EB" stroke-width="3"/>
              </svg>
            </div>
          </div>

          <div class="panel-card counter-status-card">
            <h3>Live Counter Status</h3>
            <div class="counter-list mt-12">
              <div class="counter-item active-border"><div>C-01 — Room 101</div><div class="ticket-num text-blue">A-012</div></div>
              <div class="counter-item active-border"><div>C-02 — Room 102</div><div class="ticket-num text-blue">P-003</div></div>
              <div class="counter-item inactive-border"><div>C-03 — Room 103</div><div class="ticket-num text-sub">—</div></div>
              <div class="counter-item active-border"><div>C-04 — Room 104</div><div class="ticket-num text-blue">A-013</div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ANALYTICS -->
      <section class="tab-content" id="tab-admin-analytics">
        <div class="page-header flex-between">
          <div>
            <h1>Analytics & Historical Reports</h1>
            <p>Queue performance and visitor traffic patterns.</p>
          </div>
          <button class="btn-primary">Export CSV</button>
        </div>
        <div class="panel-card mt-20">
          <h3>Peak Traffic Hours Heatmap</h3>
          <div id="heatmap-rows" class="mt-16"></div>
        </div>
      </section>

      <!-- DOCTOR MANAGEMENT -->
      <section class="tab-content" id="tab-admin-doctors">
        <div class="page-header flex-between">
          <div>
            <h1>Doctor Management</h1>
            <p>On-duty schedules and consultation room assignments.</p>
          </div>
          <button class="btn-primary" onclick="openDoctorModal()">+ Add New Doctor</button>
        </div>
        <div class="panel-card mt-20">
          <table class="admin-table">
            <thead>
              <tr><th>DOCTOR NAME</th><th>SPECIALTY</th><th>ROOM</th><th>SHIFT</th><th>STATUS</th><th>ACTIONS</th></tr>
            </thead>
            <tbody id="doctor-table-rows"></tbody>
          </table>
        </div>
      </section>

      <!-- STAFF MANAGEMENT -->
      <section class="tab-content" id="tab-admin-staff">
        <div class="page-header flex-between">
          <div>
            <h1>Staff & Role Management</h1>
            <p>Help desk operator accounts and access permissions.</p>
          </div>
          <button class="btn-primary" onclick="openStaffModal()">+ Add Staff</button>
        </div>
        <div class="panel-card mt-20">
          <table class="admin-table">
            <thead>
              <tr><th>NAME</th><th>ROLE</th><th>EMAIL</th><th>STATUS</th><th>ACTIONS</th></tr>
            </thead>
            <tbody id="staff-table-rows"></tbody>
          </table>
        </div>
      </section>

      <!-- AUDIT LOGS -->
      <section class="tab-content" id="tab-admin-audit">
        <div class="page-header flex-between">
          <div>
            <h1>Priority Verification Audit Logs</h1>
            <p>Historical verification records for Senior, PWD, and Pregnant lane tickets.</p>
          </div>
          <button class="btn-primary">Export CSV</button>
        </div>
        <div class="panel-card mt-20">
          <table class="admin-table">
            <thead>
              <tr><th>TIMESTAMP</th><th>TICKET #</th><th>CATEGORY</th><th>DOC REF #</th><th>VERIFYING STAFF</th><th>STATUS</th></tr>
            </thead>
            <tbody id="audit-table-rows"></tbody>
          </table>
        </div>
      </section>

      <!-- CONFIGURATION -->
      <section class="tab-content" id="tab-admin-config">
        <div class="page-header">
          <h1>Clinic Configuration</h1>
          <p>Global prefix rules and operational thresholds.</p>
        </div>
        <div class="panel-card mt-20">
          <h3>Queue Prefix Rules</h3>
          <div class="form-row mt-16">
            <div>
              <label>Prefix</label>
              <input type="text" value="A">
            </div>
            <div>
              <label>Queue Type</label>
              <input type="text" value="Regular Consultation">
            </div>
            <div>
              <label>Start #</label>
              <input type="number" value="1">
            </div>
          </div>
          <div class="mt-20">
            <button class="btn-primary">Save Configuration</button>
          </div>
        </div>
      </section>

    </main>
  </div>
</div>

<!-- SPOTIFY-STYLE ADMIN PROFILE SLIDE-OVER DRAWER -->
<div class="profile-backdrop" id="admin-profile-backdrop" onclick="closeAdminProfileDrawer()"></div>

<div class="profile-drawer" id="admin-profile-drawer">
  <div class="drawer-header">
    <div class="drawer-avatar admin">A</div>
    <div class="drawer-user-details">
      <div class="drawer-name">Administrator</div>
      <div class="drawer-email">admin@mediq.ph</div>
      <span class="drawer-badge admin">Superuser Access</span>
    </div>
    <button class="drawer-close-btn" onclick="closeAdminProfileDrawer()" aria-label="Close Profile">✕</button>
  </div>

  <div class="drawer-menu">
    <div class="drawer-group-label">System Overview</div>
    <button class="drawer-menu-item">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-6"/></svg>
      <span>Executive Analytics Summary</span>
    </button>
    <button class="drawer-menu-item">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span>Security & Audit Logs</span>
    </button>

    <div class="drawer-group-label">Admin Settings</div>
    <button class="drawer-menu-item">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>Security & Passwords</span>
    </button>

    <div class="drawer-divider"></div>

    <button class="drawer-menu-item text-danger" onclick="location.reload()">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <span>Sign Out</span>
    </button>
  </div>
</div>

<!-- ADD DOCTOR / STAFF MODAL DIALOG -->
<div class="modal-backdrop" id="add-modal-backdrop" onclick="closeModal()"></div>
<div class="modal-card" id="add-modal">
  <div class="modal-header">
    <h3 id="modal-title">Add Entity</h3>
    <button class="modal-close" onclick="closeModal()">✕</button>
  </div>
  <form id="modal-form" onsubmit="handleModalSubmit(event)">
    <div id="modal-fields"></div>
    <div class="modal-actions mt-20">
      <button type="button" class="btn-secondary" onclick="closeModal()">Cancel</button>
      <button type="submit" class="btn-primary">Save Record</button>
    </div>
  </form>
</div>

<script src="admin-portal.js"></script>
</body>
</html>
